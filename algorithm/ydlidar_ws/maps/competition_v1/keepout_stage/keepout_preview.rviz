Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Competition Static Map
      Alpha: 1.0
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Keepout Mask (toggle on, Map off)
      Alpha: 1.0
      Color Scheme: map
      Topic:
        Value: /keepout_filter_mask
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Blue Start Zones
      Topic:
        Value: /competition_start_zones
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 170
      X: 1.2
      Y: 1.2
