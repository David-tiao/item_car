Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Physical Base Map (yellow not blocked)
      Alpha: 1.0
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global Costmap (Keepout active)
      Alpha: 0.85
      Color Scheme: map
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Local Costmap (toggle with Global off)
      Alpha: 0.85
      Color Scheme: map
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: X3 Scan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Points
      Size (m): 0.025
      Color: 255; 100; 100
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Blue Start Zones
      Topic:
        Value: /competition_start_zones
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Road Topology
      Topic:
        Value: /competition/road_graph
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Road Route
      Topic:
        Value: /competition/road_path
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 170
      X: 1.2
      Y: 1.2
